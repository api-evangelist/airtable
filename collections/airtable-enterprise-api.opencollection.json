{
  "opencollection": "1.0.0",
  "info": {
    "name": "Airtable Audit Logs Enterprise API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Enterprise",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Airtable Get Enterprise Account Information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.airtable.com/v0/meta/enterpriseAccounts/:enterpriseAccountId",
            "params": [
              {
                "name": "enterpriseAccountId",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the enterprise account (starts with 'ent')."
              },
              {
                "name": "include",
                "value": "",
                "type": "query",
                "description": "Additional information to include in the response."
              }
            ]
          },
          "docs": "Returns information about the specified enterprise account, including the enterprise name, creation time, and optionally aggregated usage data and descendant accounts."
        }
      ]
    }
  ],
  "bundled": true
}